# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# --- Servidor ---
NODE_ENV=development
PORT=4000
# Origen permitido por CORS (URL del frontend)
CLIENT_URL=http://localhost:5173
# Detrás de un balanceador (AWS ALB) pon 1 para que el rate limit vea la IP real
TRUST_PROXY=

# --- Base de datos (PostgreSQL) ---
# node-pg-migrate y pg leen DATABASE_URL
DATABASE_URL=postgresql://taskai_user:cambia_esta_password@localhost:5432/taskai
# En AWS RDS normalmente se necesita SSL
DB_SSL=false
# Pon false solo si usas certificados autofirmados en pruebas
DB_SSL_REJECT_UNAUTHORIZED=true
# Conexiones máximas del pool
DB_POOL_MAX=10

# --- Autenticación (JWT) ---
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- IA ---
# Proveedor que genera las tareas: gemini | anthropic (por defecto: gemini).
# Solo es obligatoria la key del proveedor elegido; el servidor no arranca si falta.
AI_PROVIDER=gemini

# Gemini (Google). Key gratuita en https://aistudio.google.com/apikey
# Modelos con nivel gratuito: gemini-3.8-flash (recomendado), gemini-3.6-flash,
# gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# free | paid. Solo afecta al coste registrado en ai_audit_log (free = $0).
# Ojo: en el nivel gratuito Google usa el contenido enviado para mejorar sus productos.
GEMINI_TIER=free

# Anthropic (Claude). Key en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
